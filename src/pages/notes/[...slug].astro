---
import Base from "../../layouts/Base.astro";
import ReadingTrack from "../../components/ReadingTrack.astro";
import { getCollection } from "astro:content";
import { marked } from "marked";
import { slugOf } from "../../lib/content";

export async function getStaticPaths() {
  const all = await getCollection("notes");
  const notes = all
    .filter((n) => !n.data.draft)
    .sort(
      (a, b) =>
        new Date(b.data.published_at).getTime() -
        new Date(a.data.published_at).getTime(),
    );
  // slugOf imported from ../../lib/content

  return notes.map((n) => ({
    params: { slug: slugOf(n) },
    props: { note: n },
  }));
}

const { note } = Astro.props;
const { data, body } = note;

const langZhMarker = /<!--\s*LANG:ZH\s*-->/g;
const langEnMarker = /<!--\s*LANG:EN\s*-->/;
const stripped = (body ?? "").replace(langZhMarker, "");
// 第一个 marker 之前是中文，之后（含重复 marker）全部归英文——避免重复 marker 静默丢内容
const parts = stripped.split(langEnMarker);
const zhRaw = (parts[0] ?? "").trim();
const enRaw = parts.slice(1).join("\n\n").trim();

const zhHtml = zhRaw ? (marked.parse(zhRaw, { async: false }) as string) : "";
const enHtml = enRaw ? (marked.parse(enRaw, { async: false }) as string) : "";
const hasBoth = !!zhHtml && !!enHtml;
// 纯中文 note（英文待补）：默认 show-en 把 zh 段藏掉 → 整页无正文。去掉 zh data-lang 兜底。
const zhOnly = enRaw.length === 0;

const dateStr = new Date(data.published_at).toISOString().slice(0, 10);
const title = data.title_zh ?? data.title_en ?? "Note";
const titleEn = data.title_en ?? "";
// description 从 zh 正文派生摘要（strip md/html，取前 ~120 字），回落标题
const plainZh = zhRaw
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, "$1") // 图片/链接 → 文字
  .replace(/<[^>]+>/g, "")
  .replace(/[#>*_`~\-]+/g, "")
  .replace(/\s+/g, " ")
  .trim();
const description =
  plainZh.length > 0
    ? plainZh.slice(0, 120) + (plainZh.length > 120 ? "…" : "")
    : (data.title_en ?? data.title_zh ?? "");
const currentSlug = slugOf(note);
---

<Base
  title={`${title} — conilab`}
  description={description}
>
  <article class="note">
    <div class="wrap">
      <header class="note-head">
        <div class="note-meta">
          <time datetime={dateStr}>{dateStr}</time>
          {(data.tags ?? []).length > 0 && <span class="dot">·</span>}
          {(data.tags ?? []).length > 0 && (
            <span class="tags">{(data.tags ?? []).join(" · ")}</span>
          )}
        </div>
        <h1 class="note-titles">
          {data.title_zh && (
            <span class="note-title cjk" lang="zh" {...(zhOnly ? {} : { "data-lang": "zh" })}>{data.title_zh}</span>
          )}
          {titleEn && (
            <span class="note-title-en" lang="en" data-lang="en">{titleEn}</span>
          )}
        </h1>
        <div class="note-actions">
          <ReadingTrack
            slug={currentSlug}
            kind="note"
            titleZh={data.title_zh ?? ""}
            titleEn={titleEn}
          />
        </div>
      </header>

      <div class={`note-bodies${hasBoth ? " is-bilingual" : ""}`}>
        {zhHtml && (
          <section class="note-body" lang="zh-CN" {...(zhOnly ? {} : { "data-lang": "zh" })}>
            <div class="prose cjk" set:html={zhHtml}></div>
          </section>
        )}

        {hasBoth && (
          <div class="note-flip" aria-hidden="true">
            <span class="flip-rule"></span>
            <span class="flip-text">⊙ &nbsp; TURN IT OVER &nbsp; ⊙</span>
            <span class="flip-rule"></span>
          </div>
        )}

        {enHtml && (
          <section class="note-body" data-lang="en" lang="en">
            <div class="prose" set:html={enHtml}></div>
          </section>
        )}
      </div>

      <footer class="note-foot">
        <a class="back-link" href="/notes/">← Back to notes</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .note { padding: var(--sp-44) 0 var(--sp-96); }

  :global(html.show-zh) .note-flip,
  :global(html.show-en) .note-flip { display: none; }

  .note-head {
    border-bottom: var(--sp-hairline) solid var(--rule);
    padding-bottom: var(--sp-32);
    margin: 0 auto var(--sp-44);
    max-width: 64ch;
  }
  .note-actions {
    margin-top: var(--sp-18);
    display: flex;
    gap: var(--sp-10);
  }
  .note-meta {
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--sp-22);
    display: flex;
    gap: var(--sp-10);
    flex-wrap: wrap;
  }
  .note-meta .tags { color: var(--accent-back-ink); }
  /* 单个 h1 包两个 span：show-en 模式下也始终有 h1 */
  .note-titles {
    margin: 0;
    font-weight: var(--fw-normal);
    letter-spacing: normal;
  }
  .note-title {
    display: block;
    font-family: var(--cjk-serif);
    font-size: clamp(var(--fs-4xl), 3.5vw, 42px);
    line-height: 1.15;
    margin: 0 0 var(--sp-12);
    color: var(--accent-front-ink);
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
  }
  .note-title-en {
    display: block;
    font-family: var(--serif);
    font-size: var(--fs-2xl);
    line-height: 1.25;
    color: var(--accent-back-ink);
    font-style: italic;
    font-weight: var(--fw-light);
    margin: 0;
    letter-spacing: -0.01em;
  }
  /* zhOnly 且无 en 标题时，最后的 zh span 不该留底部 margin */
  .note-title:last-child { margin-bottom: 0; }

  .note-body { max-width: 64ch; margin: 0 auto; }

  .note-flip {
    max-width: 64ch;
    margin: var(--sp-44) auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-18);
  }
  .flip-rule {
    height: var(--sp-hairline);
    background: var(--rule);
  }
  .flip-text {
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.16em;
    color: var(--accent-back);
    white-space: nowrap;
  }

  /* ─── 双语并置：中/EN 模式下左右分列（宽屏才分，窄屏回落上下叠） ─── */
  @media (min-width: 1100px) {
    :global(html.show-both) .note-head,
    :global(html.show-both) .note-foot { max-width: none; }

    :global(html.show-both) .note-bodies.is-bilingual {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    :global(html.show-both) .note-bodies.is-bilingual::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 50%;
      width: var(--sp-hairline);
      background: var(--rule);
    }
    :global(html.show-both) .note-bodies.is-bilingual .note-body {
      max-width: none;
      margin: 0;
    }
    :global(html.show-both) .note-bodies.is-bilingual .note-body[data-lang="zh"] {
      padding-right: var(--sp-40);
    }
    :global(html.show-both) .note-bodies.is-bilingual .note-body[data-lang="en"] {
      padding-left: var(--sp-40);
    }
    :global(html.show-both) .note-bodies.is-bilingual .note-flip { display: none; }
  }

  /* ─── PROSE ─── */
  .prose {
    font-family: var(--serif);
    font-size: var(--fs-lg);
    line-height: var(--lh-prose);
    color: var(--ink);
  }
  .prose.cjk { font-family: var(--cjk-serif); }

  .prose :global(p) { margin: 0 0 var(--sp-18); }
  .prose :global(strong) { color: var(--ink); font-weight: var(--fw-medium); }

  /* 藏 URL 的行内链接：加粗 + 强调色 + 发丝下划线，明确"可点" */
  .prose :global(a) {
    color: var(--accent-front-ink);
    border-bottom: var(--sp-hairline) solid var(--accent-front);
    font-weight: var(--fw-semibold);
  }
  .prose :global(a:hover) { border-bottom-color: var(--accent-front-ink); }

  .prose :global(em) {
    font-style: italic;
    color: var(--accent-back-ink);
    font-weight: var(--fw-light);
  }
  .prose.cjk :global(em) {
    font-style: normal;
    color: inherit;
    text-decoration: underline;
    text-decoration-style: var(--cjk-em-line);
    text-decoration-color: var(--accent-front);
    text-decoration-thickness: var(--cjk-em-thickness);
    text-underline-offset: var(--cjk-em-offset);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent-back);
    padding-left: var(--sp-18);
    color: var(--ink-2);
    font-style: italic;
    margin: var(--sp-22) 0;
  }

  /* ─── 截图配图：克制图框 + mono 图注 ─── */
  .prose :global(figure) { margin: var(--sp-32) auto; }
  .prose :global(figure img) {
    border: var(--sp-hairline) solid var(--rule);
  }
  .prose :global(figure.shot) { text-align: center; }
  .prose :global(figure.shot img) {
    display: inline-block;
    max-height: 82vh;
    width: auto;
    max-width: 100%;
  }
  .prose :global(figcaption) {
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-top: var(--sp-10);
    text-align: center;
  }
  /* 手机竖屏截图三联：等高横排，窄屏自动换行堆叠 */
  .prose :global(figure.phones) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-12);
  }
  .prose :global(figure.phones img) {
    height: clamp(280px, 42vh, 460px);
    width: auto;
    max-width: 100%;
  }
  .prose :global(figure.phones figcaption) { flex-basis: 100%; }

  /* ─── FOOTER ─── */
  .note-foot {
    max-width: 64ch;
    margin: var(--sp-44) auto 0;
    padding-top: var(--sp-22);
    border-top: var(--sp-hairline) solid var(--rule);
  }
  .back-link {
    font-family: var(--mono);
    font-size: var(--fs-sm);
    color: var(--ink-3);
    letter-spacing: 0.04em;
    transition: color var(--dur-quick);
  }
  .back-link:hover { color: var(--accent-front-ink); }
</style>
