---
import Base from "../layouts/Base.astro";
import Kicker from "../components/Kicker.astro";
import CoinGlyph from "../components/CoinGlyph.astro";

const title = "Join — conilab";
const description =
  "When the next ≥3000-字 piece lands. Both sides. One email per piece, no tracking.";

// Turnstile 前端 sitekey（公开值，本就出现在页面 HTML）。生产真实 key 直接作默认；
// 本地 curl 联调时用 .env 的 PUBLIC_TURNSTILE_SITEKEY 覆盖成官方测试 key（配 .dev.vars 测试 secret）。
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "0x4AAAAAADlO5_yLuV2WKIWm";
---

<Base title={title} description={description}>
  <section class="join">
    <div class="wrap">
      <!-- ============================================================
           Header — kicker + bilingual pitch
           ============================================================ -->
      <header class="join-head">
        <Kicker text="Join · 加入" accent />

        <div class="join-pitch">
          <h1 class="join-titles">
            <span class="join-title cjk" lang="zh" data-lang="zh">
              下一篇<em>落地</em>时<br />
              通知你<em>两面</em>。
            </span>
            <span class="join-title" data-lang="en">
              When the next piece <em>lands</em>,<br />
              we'll send you <em>both sides</em>.
            </span>
          </h1>
        </div>

        <p class="join-sub cjk" lang="zh" data-lang="zh">
          一篇<em>三千字以上</em>，中文一面，英文一面。
          一封 email，没有追踪，随时退订。
        </p>
        <p class="join-sub" data-lang="en">
          One <em>≥3000-字</em> piece per email — Chinese on one side,
          English on the other. No tracking, unsubscribe anytime.
        </p>
      </header>

      <!-- ============================================================
           Form card — email subscribe
           ============================================================ -->
      <div class="join-card" data-state="idle">
        <p class="form-error" id="form-error" hidden role="alert"></p>
        <div class="card-head">
          <CoinGlyph variant="ring" />
          <span class="card-head-tag">Email · 邮箱订阅</span>
          <CoinGlyph variant="ring" />
        </div>

        <form class="join-form" novalidate>
          <label class="field">
            <span class="field-label">
              <span data-lang="zh">邮箱</span>
              <span data-lang="en">Email</span>
            </span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              spellcheck="false"
              autocapitalize="off"
              aria-describedby="email-error"
            />
          </label>

          <p class="field-error" id="email-error" role="alert" aria-live="polite" hidden>
            <span data-lang="zh">请输入有效的邮箱地址。</span>
            <span data-lang="en">Please enter a valid email address.</span>
          </p>

          <div class="cf-turnstile turnstile-widget" data-sitekey={turnstileSiteKey} data-theme="auto"></div>

          <button type="submit" class="join-btn">
            <span class="btn-glyph" aria-hidden="true">
              <CoinGlyph variant="dot" size="1.05em" />
            </span>
            <span data-lang="zh">订阅</span>
            <span data-lang="en">Subscribe</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>

          <p class="form-meta">
            <span data-lang="zh">留个邮箱就好，没有密码，没有账号。</span>
            <span data-lang="en">Just an email — no password, no account.</span>
          </p>
        </form>

        <!-- Success state（提交后展示，CSS 由 [data-state] 控制） -->
        <div class="card-success" role="status" aria-live="polite">
          <div class="success-mark" aria-hidden="true">
            <CoinGlyph variant="stamp" size="2em" />
          </div>
          <!-- 提交表单后：待邮箱确认 -->
          <div class="success-text" data-for="pending">
            <p class="success-msg cjk" lang="zh" data-lang="zh">
              <em>查收一下邮箱</em>。我们寄了一封确认信，点开链接就完成订阅。
            </p>
            <p class="success-msg" data-lang="en">
              <em>Check your inbox.</em> We sent a confirmation link — click it to finish.
            </p>
          </div>

          <!-- 点确认链接后：订阅生效 -->
          <div class="success-text" data-for="confirmed" hidden>
            <p class="success-msg cjk" lang="zh" data-lang="zh">
              <em>订阅已确认</em>。下一篇落地时，两面一起寄到。
            </p>
            <p class="success-msg" data-lang="en">
              <em>You're in.</em> Both sides, in your inbox, when the next piece lands.
            </p>
          </div>

          <!-- 退订后 -->
          <div class="success-text" data-for="unsubscribed" hidden>
            <p class="success-msg cjk" lang="zh" data-lang="zh">
              <em>已退订</em>。随时可以再回来。
            </p>
            <p class="success-msg" data-lang="en">
              <em>Unsubscribed.</em> You can come back anytime.
            </p>
          </div>
          <button type="button" class="success-back">
            <span data-lang="zh">← 回到表单</span>
            <span data-lang="en">← Back to form</span>
          </button>
        </div>

        <!-- OAuth 登录入口已移除：newsletter 订阅不需要账号登录 -->
      </div>

      <!-- ============================================================
           Fine print + already-member link
           ============================================================ -->
      <footer class="join-foot">
        <dl class="join-meta">
          <dt>Cadence</dt>
          <dd><span data-lang="zh">不定期，只发写完整的</span><span data-lang="en">no schedule — only finished pieces</span></dd>

          <dt>Privacy</dt>
          <dd><span data-lang="zh">不追踪、不卖、不广告</span><span data-lang="en">no tracking, no selling, no ads</span></dd>

          <dt>Exit</dt>
          <dd><span data-lang="zh">每封邮件底部都有退订</span><span data-lang="en">unsubscribe link at the bottom of every email</span></dd>
        </dl>
      </footer>
    </div>
  </section>

  <!-- Turnstile widget loader（第三方脚本，不走 Astro 打包）-->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
</Base>

<script>
  interface Turnstile {
    getResponse?: () => string;
    reset?: () => void;
  }

  const card = document.querySelector<HTMLDivElement>(".join-card");
  const form = document.querySelector<HTMLFormElement>(".join-form");
  const back = document.querySelector<HTMLButtonElement>(".success-back");
  const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
  const errorEl = document.getElementById("form-error");
  const emailErrorEl = document.getElementById("email-error");
  const successCard = document.querySelector<HTMLDivElement>(".card-success");

  type State = "idle" | "loading" | "success" | "error";
  const setState = (state: State) => card?.setAttribute("data-state", state);

  // success 卡里有三种文案（pending / confirmed / unsubscribed），按场景切
  const showSuccess = (kind: "pending" | "confirmed" | "unsubscribed") => {
    successCard?.querySelectorAll<HTMLElement>(".success-text").forEach((el) => {
      el.hidden = el.dataset.for !== kind;
    });
    setState("success");
  };

  const showError = (msg: string) => {
    if (errorEl) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    setState("error");
  };

  // Turnstile 全局对象（api.js 异步注入）
  const turnstile = () =>
    (window as unknown as { turnstile?: Turnstile }).turnstile;
  const getTurnstileToken = (): string => {
    const input = form?.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
    return input?.value || turnstile()?.getResponse?.() || "";
  };
  const currentLang = () =>
    document.documentElement.classList.contains("show-en") ? "en" : "zh";

  // 处理从 /api/confirm、/api/unsubscribe 重定向回来的状态
  const params = new URLSearchParams(window.location.search);
  if (params.get("confirmed") === "true") showSuccess("confirmed");
  else if (params.get("unsubscribed") === "true") showSuccess("unsubscribed");
  else if (params.get("error"))
    showError("链接无效或已过期，请重新订阅。 Link invalid or expired — please subscribe again.");

  // 重新输入时清掉校验错误
  emailInput?.addEventListener("input", () => {
    if (emailInput.getAttribute("aria-invalid") === "true") {
      emailInput.removeAttribute("aria-invalid");
      if (emailErrorEl) emailErrorEl.hidden = true;
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!emailInput) return;
    const email = emailInput.value.trim();
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if (!ok) {
      emailInput.setAttribute("aria-invalid", "true");
      if (emailErrorEl) emailErrorEl.hidden = false;
      emailInput.focus();
      return;
    }
    const token = getTurnstileToken();
    if (!token) {
      showError("请先完成人机验证。 Please complete the verification.");
      return;
    }
    emailInput.removeAttribute("aria-invalid");
    if (emailErrorEl) emailErrorEl.hidden = true;
    if (errorEl) errorEl.hidden = true;
    setState("loading");

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email, turnstileToken: token, lang: currentLang() }),
      });
      if (!res.ok) {
        const data = (await res.json().catch(() => ({}))) as { error?: string };
        const msg =
          data.error === "turnstile_failed"
            ? "人机验证未通过，请重试。 Verification failed — please try again."
            : data.error === "invalid_email"
              ? "请输入有效的邮箱地址。 Please enter a valid email."
              : "出了点问题，请稍后再试。 Something went wrong — please try again.";
        turnstile()?.reset?.();
        showError(msg);
        return;
      }
      const data = (await res.json().catch(() => ({}))) as { mode?: string };
      // mode=pending → 提示查收确认信（已接发信商）；mode=subscribed → 直接「订阅成功」（单次确认）
      showSuccess(data.mode === "pending" ? "pending" : "confirmed");
    } catch {
      turnstile()?.reset?.();
      showError("网络异常，请稍后再试。 Network error — please try again.");
    }
  });

  back?.addEventListener("click", () => {
    setState("idle");
    if (errorEl) errorEl.hidden = true;
    if (emailErrorEl) emailErrorEl.hidden = true;
    emailInput?.removeAttribute("aria-invalid");
    turnstile()?.reset?.();
    emailInput?.focus();
    window.history.replaceState({}, "", "/join");
  });
</script>

<style>
  /* ─── PAGE ─── */
  .join {
    padding: var(--sp-48) 0 var(--sp-96);
    position: relative;
  }

  /* ─── HEAD ─── */
  .join-head {
    max-width: 60ch;
    margin: 0 auto var(--sp-44);
    text-align: center;
    display: grid;
    gap: var(--sp-24);
  }
  .join-head :global(.kicker) {
    justify-self: center;
  }
  .join-pitch {
    display: grid;
    gap: var(--sp-12);
  }
  /* 单个 h1 包两个 span（zh / en）：show-en 模式下也有真正的 h1 */
  .join-titles {
    display: grid;
    gap: var(--sp-12);
    margin: 0;
    font-weight: var(--fw-normal);
    letter-spacing: normal;
  }
  .join-title {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-normal);
    font-size: clamp(var(--fs-7xl), 5vw, var(--fs-hero));
    line-height: 1.05;
    letter-spacing: -0.018em;
    margin: 0;
    color: var(--ink);
    font-variation-settings: "opsz" 56;
  }
  .join-title[data-lang="zh"] { font-family: var(--cjk-serif); }
  .join-title :global(em) {
    font-weight: var(--fw-light);
    font-style: italic;
    color: var(--accent-front-ink);
  }
  .join-title[data-lang="zh"] :global(em) {
    /* CJK em 走全局 dotted 蓝下划线（不 italic）*/
    font-style: normal;
    color: inherit;
    text-decoration: underline dotted var(--accent-front);
    text-decoration-thickness: var(--cjk-em-thickness);
    text-underline-offset: var(--cjk-em-offset);
  }
  .join-title[data-lang="en"] :global(em) {
    color: var(--accent-back-ink);
  }
  .join-sub {
    font-family: var(--serif);
    font-size: var(--fs-xl);
    line-height: var(--lh-relaxed);
    color: var(--ink-2);
    margin: 0;
    font-weight: var(--fw-light);
  }
  .join-sub[data-lang="zh"] { font-family: var(--cjk-serif); }
  .join-sub[data-lang="en"] {
    font-style: italic;
    color: var(--ink-3);
    font-size: var(--fs-lg);
  }
  .join-sub :global(em) {
    color: var(--accent-front-ink);
    font-style: italic;
  }
  .join-sub[data-lang="zh"] :global(em) {
    font-style: normal;
    color: inherit;
    text-decoration: underline dotted var(--accent-front);
    text-decoration-thickness: var(--cjk-em-thickness);
    text-underline-offset: var(--cjk-em-offset);
  }

  /* ─── CARD ─── */
  .join-card {
    max-width: 480px;
    margin: 0 auto;
    padding: var(--sp-32) var(--sp-32) var(--sp-28);
    background: var(--paper-2);
    border: var(--sp-hairline) solid var(--rule);
    border-radius: var(--rad-md);
    position: relative;
  }
  /* 卡片顶部细线（"票据"感）*/
  .join-card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: var(--sp-24);
    right: var(--sp-24);
    height: 2px;
    background: var(--accent-front);
  }

  .form-error {
    font-family: var(--sans);
    font-size: var(--fs-md);
    color: var(--err-ink);
    background: color-mix(in oklch, var(--err-ink) 8%, var(--paper));
    border: var(--sp-hairline) solid color-mix(in oklch, var(--err-ink) 30%, var(--rule));
    border-radius: var(--rad-sm);
    padding: var(--sp-10) var(--sp-14);
    margin: 0 0 var(--sp-16);
    text-align: center;
  }
  .form-error[hidden] { display: none; }
  .join-card[data-state="error"] .join-form { opacity: 1; pointer-events: auto; }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-12);
    margin-bottom: var(--sp-22);
    color: var(--ink-3);
  }
  .card-head-tag {
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* ─── FORM ─── */
  .join-form {
    display: grid;
    gap: var(--sp-16);
  }
  .field {
    display: grid;
    gap: var(--sp-6);
  }
  .field-label {
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: flex;
    align-items: baseline;
    gap: var(--sp-6);
  }
  .field input {
    appearance: none;
    background: var(--paper);
    border: var(--sp-hairline) solid var(--rule);
    border-radius: var(--rad-sm);
    padding: var(--sp-12) var(--sp-14);
    font-family: var(--serif);
    font-size: var(--fs-xl);
    color: var(--ink);
    line-height: 1.3;
    transition: border-color var(--dur-quick), background-color var(--dur-quick), box-shadow var(--dur-quick);
  }
  .field input::placeholder {
    color: var(--ink-3);
    font-style: italic;
    font-weight: var(--fw-light);
  }
  .field input:focus {
    outline: none;
    border-color: var(--accent-front);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent-front) 18%, transparent);
  }
  .field input[aria-invalid="true"] {
    border-color: var(--err-ink);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--err-ink) 14%, transparent);
  }

  /* 邮箱校验失败的可见提示（mono 小字 + err 色，跟随双语体系）*/
  .field-error {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--err-ink);
    margin: calc(-1 * var(--sp-8)) 0 0;
    padding-left: var(--sp-2);
  }
  .field-error[hidden] { display: none; }

  .join-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-10);
    background: var(--ink);
    color: var(--paper);
    border: var(--sp-hairline) solid var(--ink);
    border-radius: var(--rad-pill);
    padding: var(--sp-13) var(--sp-22);
    font-family: var(--sans);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    cursor: pointer;
    margin-top: var(--sp-8);
    transition: background-color var(--dur-quick), color var(--dur-quick), transform var(--dur-quick);
  }
  .join-btn:hover {
    background: var(--accent-front);
    border-color: var(--accent-front);
  }
  .join-btn:active { transform: translateY(1px); }
  .btn-glyph {
    display: inline-flex;
    color: var(--paper);
  }
  .btn-arrow {
    transition: transform var(--dur-quick);
  }
  .join-btn:hover .btn-arrow { transform: translateX(3px); }

  .form-meta {
    font-family: var(--serif);
    font-size: var(--fs-md);
    color: var(--ink-3);
    margin: var(--sp-4) 0 0;
    text-align: center;
    font-style: italic;
  }

  /* ─── SUCCESS STATE ─── */
  .card-success {
    display: none;
    text-align: center;
    padding: var(--sp-22) 0 var(--sp-12);
  }
  .join-card[data-state="loading"] .join-form { opacity: 0.55; pointer-events: none; }
  .join-card[data-state="success"] .join-form { display: none; }
  .join-card[data-state="success"] .card-success { display: grid; gap: var(--sp-14); justify-items: center; }
  .success-text[hidden] { display: none; }
  .success-mark {
    color: var(--accent-back);
    animation: stamp-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes stamp-in {
    from { opacity: 0; transform: scale(0.6) rotate(-15deg); }
    to   { opacity: 1; transform: scale(1) rotate(0deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .success-mark { animation: none; }
  }
  .success-msg {
    font-family: var(--serif);
    font-size: var(--fs-xl);
    color: var(--ink);
    line-height: var(--lh-relaxed);
    max-width: 36ch;
    margin: 0;
  }
  .success-msg[data-lang="zh"] { font-family: var(--cjk-serif); }
  .success-msg[data-lang="en"] {
    color: var(--ink-2);
    font-style: italic;
    font-size: var(--fs-lg);
  }
  .success-msg :global(em) { color: var(--accent-front-ink); }
  .success-msg[data-lang="zh"] :global(em) {
    font-style: normal;
    color: inherit;
    text-decoration: underline dotted var(--accent-front);
    text-decoration-thickness: var(--cjk-em-thickness);
    text-underline-offset: var(--cjk-em-offset);
  }
  .success-back {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: var(--sp-6) var(--sp-10);
    transition: color var(--dur-quick);
  }
  .success-back:hover { color: var(--accent-front-ink); }

  /* ─── TURNSTILE ─── */
  .turnstile-widget {
    display: flex;
    justify-content: center;
    min-height: 65px; /* 占位，避免 widget 异步加载时表单跳动 */
  }

  /* ─── FOOTER META ─── */
  .join-foot {
    max-width: 480px;
    margin: var(--sp-32) auto 0;
    display: grid;
    gap: var(--sp-22);
  }
  .join-meta {
    font-family: var(--mono);
    font-size: var(--fs-sm);
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--sp-6) var(--sp-18);
    margin: 0;
    padding: var(--sp-18) 0 0;
    border-top: var(--sp-hairline) dashed var(--rule);
  }
  .join-meta dt {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .join-meta dd {
    margin: 0;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: var(--fs-md);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 640px) {
    .join-card { padding: var(--sp-22) var(--sp-20) var(--sp-22); }
    .join-meta { grid-template-columns: 1fr; gap: var(--sp-2); }
    .join-meta dt { padding-top: var(--sp-8); }
  }

  /* —— Single-language modes：在 zh-only / en-only 时清理 fallback 混排 —— */
  :global(html.show-zh) .join-title[data-lang="en"],
  :global(html.show-zh) .join-sub[data-lang="en"] { display: none; }
  :global(html.show-en) .join-title[data-lang="zh"],
  :global(html.show-en) .join-sub[data-lang="zh"] { display: none; }
</style>
